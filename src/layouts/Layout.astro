---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
    title: string;
    description?: string;
    ogImage?: string;
    ogType?: "website" | "article" | "profile";
}

const {
    title,
    description = "Prof. Dr. Pedro Balikian Junior — Pesquisador em fisiologia, metabolômica e inteligência artificial aplicada à saúde e ao esporte.",
    ogImage = "/images/homehero.jpeg",
    ogType = "website",
} = Astro.props;

const nav = [
    { label: "Sobre", href: "/sobre" },
    { label: "Pesquisa", href: "/pesquisa" },
    { label: "Blog", href: "/blog" },
    { label: "Veltron", href: "/veltron" },
    { label: "Contato", href: "/contato" },
];

// URLs absolutas (obrigatórias para OG)
const siteURL = Astro.site || new URL(Astro.url.origin);
const canonicalURL = new URL(Astro.url.pathname, siteURL).toString();
const ogImageURL = ogImage.startsWith("http")
    ? ogImage
    : new URL(ogImage, siteURL).toString();
---

<!doctype html>
<html lang="pt-BR">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />

        <!-- Primary Meta Tags -->
        <title>{title}</title>
        <meta name="title" content={title} />
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalURL} />

        <!-- Open Graph / Facebook / LinkedIn / WhatsApp -->
        <meta property="og:type" content={ogType} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImageURL} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta
            property="og:site_name"
            content="Prof. Dr. Pedro Balikian Junior"
        />
        <meta property="og:locale" content="pt_BR" />

        <!-- Twitter / X -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:url" content={canonicalURL} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageURL} />

        <!-- Favicon -->
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

        <!-- Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />

        <ClientRouter />
    </head>
    <body>
        <header
            transition:persist
            class="sticky top-0 z-50 border-b border-black/5 bg-[#FAFAF7]/80 backdrop-blur"
        >
            <nav
                class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5"
            >
                <a href="/" class="text-sm font-semibold tracking-widest"
                    >PEDRO BALIKIAN JR.</a
                >
                <ul class="hidden gap-8 text-sm md:flex">
                    {
                        nav.map((item) => (
                            <li>
                                <a
                                    href={item.href}
                                    class="text-black/70 transition-colors hover:text-[#1E40AF]"
                                >
                                    {item.label}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </nav>
        </header>

        <main><slot /></main>

        <footer transition:persist class="mt-32 bg-[#EDEDED] text-black/70">
            <div class="mx-auto max-w-6xl px-6 py-12">
                <!-- Linha principal -->
                <div class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
                    <div>
                        <p class="text-sm font-semibold tracking-widest text-black">PEDRO BALIKIAN JR.</p>
                        <p class="mt-1 text-xs text-black/50">
                            Ciência, medicina de precisão e performance humana.
                        </p>
                    </div>

                    <nav>
                        <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
                            <li><a href="/sobre" class="text-black/70 transition-colors hover:text-[#1E40AF]">Sobre</a></li>
                            <li><a href="/pesquisa" class="text-black/70 transition-colors hover:text-[#1E40AF]">Pesquisa</a></li>
                            <li><a href="/blog" class="text-black/70 transition-colors hover:text-[#1E40AF]">Blog</a></li>
                            <li><a href="/veltron" class="text-black/70 transition-colors hover:text-[#1E40AF]">Veltron</a></li>
                            <li><a href="/contato" class="text-black/70 transition-colors hover:text-[#1E40AF]">Contato</a></li>
                        </ul>
                    </nav>
                </div>

                <!-- Divisor + linha inferior -->
                <div class="mt-10 pt-6 border-t border-black/10 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
                    <p class="text-xs text-black/40">
                        © {new Date().getFullYear()} Pedro Balikian Junior · Maceió, Brasil
                    </p>
                    <div class="flex gap-5 text-xs">
                        <a href="#" target="_blank" rel="noopener noreferrer" class="text-black/50 hover:text-[#1E40AF] transition-colors">ORCID</a>
                        <a href="#" target="_blank" rel="noopener noreferrer" class="text-black/50 hover:text-[#1E40AF] transition-colors">Scholar</a>
                        <a href="#" target="_blank" rel="noopener noreferrer" class="text-black/50 hover:text-[#1E40AF] transition-colors">Lattes</a>
                        <a href="#" target="_blank" rel="noopener noreferrer" class="text-black/50 hover:text-[#1E40AF] transition-colors">LinkedIn</a>
                    </div>
                </div>
            </div>
        </footer>

        <script is:inline>
            // Scroll reveal — usa CSS animations (declarativas, mais confiáveis)
            (function () {
                // Fallback: se sem IntersectionObserver, mostrar tudo
                if (typeof IntersectionObserver === "undefined") {
                    document
                        .querySelectorAll(
                            ".reveal, .reveal-scale, .reveal-left",
                        )
                        .forEach((el) => el.classList.add("is-visible"));
                    return;
                }

                let observer;
                function ensureObserver() {
                    if (observer) return observer;
                    observer = new IntersectionObserver(
                        (entries) => {
                            entries.forEach((entry) => {
                                if (entry.isIntersecting) {
                                    entry.target.classList.add("is-visible");
                                    observer.unobserve(entry.target);
                                }
                            });
                        },
                        {
                            threshold: 0.05,
                            rootMargin: "0px 0px -40px 0px",
                        },
                    );
                    return observer;
                }

                function bind() {
                    const els = document.querySelectorAll(
                        ".reveal:not(.is-visible), .reveal-scale:not(.is-visible), .reveal-left:not(.is-visible)",
                    );
                    if (!els.length) return;
                    const obs = ensureObserver();
                    els.forEach((el) => obs.observe(el));

                    // Fallback de segurança: se por algum motivo o observer não disparar em 2s,
                    // força visibilidade pra não deixar conteúdo escondido.
                    setTimeout(() => {
                        document
                            .querySelectorAll(
                                ".reveal:not(.is-visible), .reveal-scale:not(.is-visible), .reveal-left:not(.is-visible)",
                            )
                            .forEach((el) => {
                                const rect = el.getBoundingClientRect();
                                if (
                                    rect.top < window.innerHeight &&
                                    rect.bottom > 0
                                ) {
                                    el.classList.add("is-visible");
                                }
                            });
                    }, 2000);
                }

                if (document.readyState === "loading") {
                    document.addEventListener("DOMContentLoaded", bind);
                } else {
                    bind();
                }
                document.addEventListener("astro:page-load", bind);
            })();

            // Number counter animation
            (function () {
                if (typeof IntersectionObserver === "undefined") return;
                function bindCounters() {
                    const counters = document.querySelectorAll(
                        "[data-count]:not([data-counted])",
                    );
                    if (!counters.length) return;
                    const counterObs = new IntersectionObserver(
                        (entries) => {
                            entries.forEach((entry) => {
                                if (!entry.isIntersecting) return;
                                const el = entry.target;
                                if (el.dataset.counted) return;
                                el.dataset.counted = "true";
                                const raw =
                                    el.getAttribute("data-count") || "0";
                                const target = parseInt(
                                    raw.replace(/\D/g, ""),
                                    10,
                                );
                                const suffix = raw.replace(/[0-9]/g, "");
                                const duration = 1600;
                                const start = performance.now();
                                function step(now) {
                                    const p = Math.min(
                                        (now - start) / duration,
                                        1,
                                    );
                                    const eased = 1 - Math.pow(1 - p, 3);
                                    const value = Math.round(target * eased);
                                    el.textContent =
                                        value
                                            .toString()
                                            .padStart(
                                                raw.startsWith("0") ? 2 : 0,
                                                "0",
                                            ) + suffix;
                                    if (p < 1) requestAnimationFrame(step);
                                }
                                requestAnimationFrame(step);
                                counterObs.unobserve(el);
                            });
                        },
                        { threshold: 0.4 },
                    );
                    counters.forEach((c) => counterObs.observe(c));
                }
                bindCounters();
                document.addEventListener("astro:page-load", bindCounters);
            })();

            // Smooth scroll ao topo em navegação
            document.addEventListener("astro:after-swap", () => {
                window.scrollTo({ top: 0, behavior: "instant" });
            });
        </script>

        <style is:global>
            /* View Transitions padrão do Astro — cross-fade suave */
            ::view-transition-old(root),
            ::view-transition-new(root) {
                animation-duration: 0.45s;
                animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
            }
        </style>
    </body>
</html>
