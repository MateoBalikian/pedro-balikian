---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
    title: string;
    description?: string;
}

const {
    title,
    description = "Prof. Dr. Pedro Balikian Junior — Pesquisador em fisiologia, metabolômica e inteligência artificial aplicada à saúde e ao esporte.",
} = Astro.props;

const nav = [
    { label: "Sobre", href: "/sobre" },
    { label: "Pesquisa", href: "/pesquisa" },
    { label: "Blog", href: "/blog" },
    { label: "Veltron", href: "/veltron" },
    { label: "Contato", href: "/contato" },
];
---

<!doctype html>
<html lang="pt-BR">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />
        <title>{title}</title>
        <ClientRouter />
    </head>
    <body>
        <header
            transition:persist
            class="sticky top-0 z-50 border-b border-black/5 bg-[#FAFAF7]/80 backdrop-blur"
        >
            <nav
                class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5"
            >
                <a href="/" class="text-sm font-semibold tracking-widest"
                    >PEDRO BALIKIAN JR.</a
                >
                <ul class="hidden gap-8 text-sm md:flex">
                    {
                        nav.map((item) => (
                            <li>
                                <a
                                    href={item.href}
                                    class="text-black/70 transition-colors hover:text-[#1E40AF]"
                                >
                                    {item.label}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </nav>
        </header>

        <main><slot /></main>

        <footer transition:persist class="mt-24 border-t border-black/5">
            <div class="mx-auto max-w-6xl px-6 py-16">
                <p class="font-serif text-3xl md:text-4xl">
                    Pesquisa que antecipa. Ciência que aproxima.
                </p>
                <div
                    class="mt-12 flex flex-col justify-between gap-6 md:flex-row md:items-end"
                >
                    <div>
                        <p class="font-medium">
                            Prof. Dr. Pedro Balikian Junior
                        </p>
                        <p class="mt-1 text-sm text-black/60">
                            Inteligência Artificial · Metabolômica · Biomecânica
                        </p>
                    </div>
                    <div
                        class="flex gap-6 text-xs font-semibold tracking-widest"
                    >
                        <a href="#" class="text-black/70 hover:text-[#1E40AF]"
                            >ORCID</a
                        >
                        <a href="#" class="text-black/70 hover:text-[#1E40AF]"
                            >LINKEDIN</a
                        >
                        <a href="#" class="text-black/70 hover:text-[#1E40AF]"
                            >SCHOLAR</a
                        >
                    </div>
                </div>
            </div>
        </footer>

        <script is:inline>
            // Scroll reveal observer — usa double rAF pra garantir que o browser paint o estado inicial antes de disparar
            (function () {
                if (typeof IntersectionObserver === "undefined") return;
                let observer;

                function ensureObserver() {
                    if (observer) return observer;
                    observer = new IntersectionObserver(
                        (entries) => {
                            entries.forEach((entry) => {
                                if (entry.isIntersecting) {
                                    entry.target.classList.add("is-visible");
                                    observer.unobserve(entry.target);
                                }
                            });
                        },
                        {
                            threshold: 0.12,
                            rootMargin: "0px 0px -60px 0px",
                        },
                    );
                    return observer;
                }

                function bind() {
                    const els = document.querySelectorAll(
                        ".reveal:not(.is-visible), .reveal-scale:not(.is-visible), .reveal-left:not(.is-visible)",
                    );
                    if (!els.length) return;
                    const obs = ensureObserver();
                    // Double rAF garante que o CSS inicial pintou antes de observarmos
                    requestAnimationFrame(() =>
                        requestAnimationFrame(() => {
                            els.forEach((el) => obs.observe(el));
                        }),
                    );
                }

                bind();
                document.addEventListener("astro:page-load", bind);
            })();

            // Number counter animation
            (function () {
                if (typeof IntersectionObserver === "undefined") return;
                function bindCounters() {
                    const counters = document.querySelectorAll(
                        "[data-count]:not([data-counted])",
                    );
                    if (!counters.length) return;
                    const counterObs = new IntersectionObserver(
                        (entries) => {
                            entries.forEach((entry) => {
                                if (!entry.isIntersecting) return;
                                const el = entry.target;
                                if (el.dataset.counted) return;
                                el.dataset.counted = "true";
                                const raw =
                                    el.getAttribute("data-count") || "0";
                                const target = parseInt(
                                    raw.replace(/\D/g, ""),
                                    10,
                                );
                                const suffix = raw.replace(/[0-9]/g, "");
                                const duration = 1600;
                                const start = performance.now();
                                function step(now) {
                                    const p = Math.min(
                                        (now - start) / duration,
                                        1,
                                    );
                                    const eased = 1 - Math.pow(1 - p, 3);
                                    const value = Math.round(target * eased);
                                    el.textContent =
                                        value
                                            .toString()
                                            .padStart(
                                                raw.startsWith("0") ? 2 : 0,
                                                "0",
                                            ) + suffix;
                                    if (p < 1) requestAnimationFrame(step);
                                }
                                requestAnimationFrame(step);
                                counterObs.unobserve(el);
                            });
                        },
                        { threshold: 0.4 },
                    );
                    counters.forEach((c) => counterObs.observe(c));
                }
                bindCounters();
                document.addEventListener("astro:page-load", bindCounters);
            })();

            // Smooth scroll ao topo em navegação
            document.addEventListener("astro:after-swap", () => {
                window.scrollTo({ top: 0, behavior: "instant" });
            });
        </script>

        <style is:global>
            /* View Transitions padrão do Astro — cross-fade suave */
            ::view-transition-old(root),
            ::view-transition-new(root) {
                animation-duration: 0.45s;
                animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
            }
        </style>
    </body>
</html>
