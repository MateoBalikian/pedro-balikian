---
import Layout from "../layouts/Layout.astro";

const whatsappPrograma =
    "https://wa.me/5582999652230?text=Ol%C3%A1%2C%20quero%20saber%20mais%20sobre%20o%20Programa%20de%20Acompanhamento%20Semestral%20da%20Veltron.";

const inclusos = [
    "Teste de Lactato + Zonas de treino",
    "Análise Biomecânica Computacional",
    "Perfil Metabolômico Salivar (11 marcadores)",
    "Reavaliações: 2 biomecânicas + 1 de lactato e zonas",
];

const programas = [
    { esporte: "TRIATLO", nome: "Veltron Tri Pro 6M", de: "R$ 1.690", por: "1.490" },
    { esporte: "CICLISMO", nome: "Veltron Bike Pro 6M", de: "R$ 1.590", por: "1.390" },
    { esporte: "CORRIDA", nome: "Veltron Run Pro 6M", de: "R$ 1.590", por: "1.390" },
    { esporte: "NATAÇÃO", nome: "Veltron Swim Pro 6M", de: "R$ 1.590", por: "1.390" },
];

const packs = [
    { pct: "10%", nome: "Pack Dupla", texto: "2 atletas: 10% de desconto para ambos." },
    { pct: "15%", nome: "Pack Equipe", texto: "3 a 5 atletas: 15% de desconto + Teste de Lactato (ou Análise Biomecânica extra) cortesia para o coach." },
    { pct: "20%", nome: "Pack Pelotão", texto: "6 ou mais atletas: 20% de desconto + relatório consolidado para a equipe." },
];
---

<Layout title="Veltron | Prof. Dr. Pedro Balikian Junior">
    <section class="mx-auto max-w-6xl px-6 pt-16 pb-16 md:pt-24">
        <p class="reveal mb-6 text-xs font-semibold tracking-[0.2em] text-[#171717]">EMPRESA</p>
        <img
            src="/images/veltron_logo_completo.png"
            alt="Veltron"
            class="reveal reveal-delay-1 max-w-[320px] md:max-w-[520px] w-full h-auto object-contain mb-8 invert"
            loading="eager"
        />
        <p class="reveal reveal-delay-2 max-w-2xl font-serif text-xl leading-relaxed text-black/70 md:text-2xl">
            Metabolômica assistida por inteligência artificial. Uma nova geração de ferramentas para medicina de precisão.
        </p>
    </section>

    <section id="programa" class="border-t border-black/5 bg-[#0A0A0A] text-white">
        <div class="mx-auto max-w-6xl px-6 py-16 md:py-24">
            <div class="flex flex-wrap items-center gap-3 mb-6">
                <p class="reveal text-xs font-semibold tracking-[0.2em] text-white/60">PROGRAMA DE ACOMPANHAMENTO SEMESTRAL</p>
                <span class="reveal rounded-full border border-white/40 px-3 py-1 text-[0.7rem] font-semibold tracking-[0.12em] text-white/90">CONDIÇÃO DE LANÇAMENTO · MACEIÓ/AL · VAGAS LIMITADAS</span>
            </div>
            <h2 class="reveal reveal-delay-1 font-serif text-4xl leading-tight md:text-6xl mb-4">Seis meses de evolução medida.</h2>
            <p class="reveal reveal-delay-2 max-w-2xl text-lg leading-relaxed text-white/75 mb-12">
                A evolução da sua performance monitorada mês a mês com alta tecnologia. Um programa para cada modalidade, com a mesma base de avaliações e três reavaliações ao longo do semestre.
            </p>

            <div class="grid gap-6 md:grid-cols-2">
                {programas.map((prog) => (
                    <div class="reveal rounded-lg bg-white p-8 text-[#0A0A0A]">
                        <p class="mb-2 text-xs font-semibold tracking-[0.2em] text-black/50">{prog.esporte}</p>
                        <h3 class="font-serif text-2xl md:text-3xl mb-5">{prog.nome}</h3>
                        <ul class="space-y-2 text-sm leading-relaxed text-black/75 mb-6">
                            {inclusos.map((item) => (
                                <li class="flex gap-3"><span class="mt-[0.55em] h-1.5 w-1.5 shrink-0 rounded-full bg-[#0A0A0A]"></span><span>{item}</span></li>
                            ))}
                        </ul>
                        <div class="border-t border-black/10 pt-5">
                            <span class="text-sm text-black/45 line-through">de {prog.de}</span>
                            <p class="font-serif text-4xl md:text-5xl leading-none mt-1"><span class="text-xl align-top mr-1">R$</span>{prog.por}</p>
                            <p class="mt-2 text-sm font-medium text-black/60">ou em até 6x sem juros</p>
                        </div>
                    </div>
                ))}
            </div>

            <div class="mt-6 grid gap-6 md:grid-cols-[0.9fr_1.4fr]">
                <div class="reveal rounded-lg border border-white/25 p-8">
                    <p class="mb-3 text-xs font-semibold tracking-[0.2em] text-white/60">UPGRADE DISPONÍVEL</p>
                    <p class="text-sm leading-relaxed text-white/80">
                        Troque o perfil salivar pelo <strong class="text-white">Perfil Metabolômico Urinário (100 marcadores)</strong> no início do ciclo.
                    </p>
                    <p class="mt-4 font-serif text-3xl">R$ 1.970 <span class="font-sans text-sm text-white/60">em até 6x</span></p>
                </div>
                <div class="reveal rounded-lg border border-white/25 p-8">
                    <p class="mb-4 text-xs font-semibold tracking-[0.2em] text-white/60">VANTAGENS PARA ASSESSORIAS E GRUPOS</p>
                    <ul class="space-y-4">
                        {packs.map((pack) => (
                            <li class="grid grid-cols-[4.5rem_1fr] items-baseline gap-4">
                                <span class="font-serif text-3xl text-right">{pack.pct}</span>
                                <span class="text-sm leading-relaxed text-white/80"><strong class="text-white">{pack.nome}.</strong> {pack.texto}</span>
                            </li>
                        ))}
                    </ul>
                </div>
            </div>

            <div class="reveal mt-10 flex flex-wrap items-center justify-between gap-6 rounded-lg bg-white p-8 text-[#0A0A0A]">
                <div>
                    <p class="font-serif text-2xl md:text-3xl">Garanta sua vaga no ciclo semestral.</p>
                    <p class="mt-1 text-sm text-black/60">Vagas limitadas · WhatsApp (82) 99965-2230</p>
                </div>
                <a href={whatsappPrograma} target="_blank" rel="noopener noreferrer" class="rounded-md bg-[#0A0A0A] px-6 py-4 text-sm font-medium text-white transition-opacity hover:opacity-90">
                    Agendar pelo WhatsApp
                </a>
            </div>

            <p class="mt-6 text-xs leading-relaxed text-white/45">
                A metabolômica apoia a avaliação integrada e não estabelece, isoladamente, diagnóstico clínico ou previsão individual de lesões.
            </p>
        </div>
    </section>

    <section class="border-t border-black/5">
        <div class="mx-auto max-w-6xl px-6 py-16 md:py-24">
            <div class="grid gap-12 md:grid-cols-2 md:gap-16">
                <div>
                    <p class="reveal mb-4 text-xs font-semibold tracking-[0.2em] text-[#171717]">MISSÃO</p>
                    <p class="text-lg leading-relaxed text-black/80">
                        Traduzir dados biológicos complexos em decisões clínicas acessíveis. A Veltron desenvolve sistemas de análise metabolômica com inteligência artificial voltados para profissionais de saúde.
                    </p>
                </div>
                <div>
                    <p class="reveal mb-4 text-xs font-semibold tracking-[0.2em] text-[#171717]">VISÃO</p>
                    <p class="text-lg leading-relaxed text-black/80">
                        Um futuro em que decisões clínicas sejam guiadas por leituras biológicas contínuas, individualizadas e interpretáveis — e não por médias populacionais.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <section class="border-t border-black/5">
        <div class="mx-auto max-w-6xl px-6 py-16 md:py-24">
            <p class="reveal mb-4 text-xs font-semibold tracking-[0.2em] text-[#171717]">O QUE FAZEMOS</p>
            <h2 class="reveal reveal-delay-1 font-serif text-4xl leading-tight md:text-5xl mb-12">Três frentes, um propósito.</h2>
            <div class="grid gap-6 md:grid-cols-3">
                <div class="reveal rounded-lg border border-black/10 p-8 bg-white transition-all hover:border-[#171717] hover:shadow-lg">
                    <div class="mb-6 text-[#171717]">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="6" cy="6" r="2"/><circle cx="18" cy="6" r="2"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="18" r="2"/><circle cx="12" cy="12" r="2"/><line x1="7.5" y1="7.5" x2="10.5" y2="10.5"/><line x1="16.5" y1="7.5" x2="13.5" y2="10.5"/><line x1="7.5" y1="16.5" x2="10.5" y2="13.5"/><line x1="16.5" y1="16.5" x2="13.5" y2="13.5"/></svg>
                    </div>
                    <h3 class="font-serif text-xl mb-3">Análise metabolômica automatizada</h3>
                    <p class="text-sm leading-relaxed text-black/70">Pipelines de processamento e anotação de espectros metabolômicos com padronização clínica.</p>
                </div>
                <div class="reveal rounded-lg border border-black/10 p-8 bg-white transition-all hover:border-[#171717] hover:shadow-lg">
                    <div class="mb-6 text-[#171717]">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="4" cy="6" r="1.5"/><circle cx="4" cy="18" r="1.5"/><circle cx="20" cy="12" r="1.5"/><circle cx="12" cy="6" r="1.5"/><circle cx="12" cy="18" r="1.5"/><line x1="5.5" y1="6" x2="10.5" y2="6"/><line x1="5.5" y1="18" x2="10.5" y2="18"/><line x1="13.5" y1="6.5" x2="18.5" y2="11"/><line x1="13.5" y1="17.5" x2="18.5" y2="13"/></svg>
                    </div>
                    <h3 class="font-serif text-xl mb-3">Modelos preditivos interpretáveis</h3>
                    <p class="text-sm leading-relaxed text-black/70">Algoritmos de IA validados clinicamente, com transparência para uso responsável pelo profissional.</p>
                </div>
                <div class="reveal rounded-lg border border-black/10 p-8 bg-white transition-all hover:border-[#171717] hover:shadow-lg">
                    <div class="mb-6 text-[#171717]">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.5" fill="currentColor"/></svg>
                    </div>
                    <h3 class="font-serif text-xl mb-3">Plataforma clínica integrada</h3>
                    <p class="text-sm leading-relaxed text-black/70">Interface acessível para profissionais não técnicos, com laudos interpretáveis e histórico do paciente.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="border-t border-black/5">
        <div class="mx-auto max-w-6xl px-6 py-16 md:py-24">
            <p class="reveal mb-4 text-xs font-semibold tracking-[0.2em] text-[#171717]">ONDE APLICAMOS</p>
            <h2 class="reveal reveal-delay-1 font-serif text-4xl leading-tight md:text-5xl mb-12">Setores atendidos.</h2>
            <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
                <div class="reveal border-l-2 border-[#171717] pl-6">
                    <h3 class="font-serif text-xl mb-2">Medicina preventiva</h3>
                    <p class="text-sm text-black/70">Triagem metabólica de tendências em atenção primária e check-ups executivos.</p>
                </div>
                <div class="reveal border-l-2 border-[#171717] pl-6">
                    <h3 class="font-serif text-xl mb-2">Nutrição personalizada</h3>
                    <p class="text-sm text-black/70">Suporte a intervenções nutricionais baseadas em perfil metabólico individual.</p>
                </div>
                <div class="reveal border-l-2 border-[#171717] pl-6">
                    <h3 class="font-serif text-xl mb-2">Fisiologia esportiva</h3>
                    <p class="text-sm text-black/70">Análise de adaptação, recuperação e resposta ao treinamento em atletas de alto rendimento.</p>
                </div>
                <div class="reveal border-l-2 border-[#171717] pl-6">
                    <h3 class="font-serif text-xl mb-2">Pesquisa clínica</h3>
                    <p class="text-sm text-black/70">Infraestrutura de análise para estudos translacionais em universidades e centros de pesquisa.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="bg-[#0A0A0A] text-white">
        <div class="mx-auto max-w-4xl px-6 py-20 text-center">
            <p class="mb-4 text-xs font-semibold tracking-[0.2em] text-white/60">EMPRESA</p>
            <h2 class="reveal reveal-delay-1 font-serif text-4xl md:text-6xl mb-4">Conheça a Veltron.</h2>
            <p class="text-lg text-white/70 mb-8 max-w-xl mx-auto">
                Uma nova geração de ferramentas para medicina de precisão.
            </p>
            <div class="flex flex-wrap justify-center gap-3">
                <a href="https://www.veltrontech.com.br/" target="_blank" rel="noopener noreferrer" class="rounded-md border border-white/40 px-5 py-3 text-sm font-medium text-white transition-colors hover:bg-white/10">Visitar site oficial →</a>
                <a href="/contato#atendimento" class="rounded-md bg-white px-5 py-3 text-sm font-medium text-[#0A0A0A] transition-opacity hover:opacity-90">Falar com o time</a>
            </div>
        </div>
    </section>
</Layout>
