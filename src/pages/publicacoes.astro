---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const publicacoes = (await getCollection("publicacoes")).sort(
    (a, b) => b.data.year - a.data.year,
);

// Agrupar por ano
const grupos = publicacoes.reduce(
    (acc, pub) => {
        const year = pub.data.year;
        if (!acc[year]) acc[year] = [];
        acc[year].push(pub);
        return acc;
    },
    {} as Record<number, typeof publicacoes>,
);

const anos = Object.keys(grupos)
    .map(Number)
    .sort((a, b) => b - a);

const todasCategorias = ["Artigo", "Livro", "Capítulo", "Patente", "Editorial"];
// Só mostra filtro e contador das categorias que têm publicações
const categoriasComItens = todasCategorias.filter((c) =>
    publicacoes.some((p) => p.data.category === c),
);
const categorias = ["Todos", ...categoriasComItens];

const rotulos: Record<string, string> = {
    Artigo: "Artigos",
    Livro: "Livros",
    "Capítulo": "Capítulos",
    Patente: "Patentes",
    Editorial: "Editoriais",
};

// Converter **texto** em <strong>texto</strong> nos autores
function renderAuthors(authors: string): string {
    return authors.replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>");
}

const contadores = categoriasComItens.map((c) => ({
    rotulo: rotulos[c],
    total: publicacoes.filter((p) => p.data.category === c).length,
}));
---

<Layout title="Publicações | Prof. Dr. Pedro Balikian Junior">
    <section class="mx-auto max-w-6xl px-6 pt-16 pb-16 md:pt-24">
        <p class="mb-4 text-xs font-semibold tracking-[0.2em] text-[#171717]">PUBLICAÇÕES</p>
        <h1 class="font-serif text-5xl leading-[1.05] md:text-7xl mb-6">
            Produção científica<br />revisada por pares.
        </h1>
        <p class="max-w-2xl text-lg leading-relaxed text-black/70">
            Seleção de artigos que documentam três décadas de pesquisa em fisiologia do exercício, metabolômica, biomecânica e inteligência artificial aplicada à saúde. A lista completa está no Currículo Lattes.
        </p>
    </section>

    <section class="border-t border-black/5">
        <div class="mx-auto max-w-6xl px-6 py-12">
            <div class="flex flex-wrap gap-4">
                <a href="https://orcid.org/0000-0001-5530-7446" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-md border border-black/15 px-5 py-3 text-sm font-medium transition-colors hover:border-[#171717] hover:text-[#171717]">
                    ORCID <span class="text-[#171717]">→</span>
                </a>
                <a href="https://scholar.google.com/citations?hl=pt-BR&user=m6b9eaQAAAAJ" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-md border border-black/15 px-5 py-3 text-sm font-medium transition-colors hover:border-[#171717] hover:text-[#171717]">
                    Google Scholar <span class="text-[#171717]">→</span>
                </a>
                <a href="http://lattes.cnpq.br/8602899861883239" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-md border border-black/15 px-5 py-3 text-sm font-medium transition-colors hover:border-[#171717] hover:text-[#171717]">
                    Lattes <span class="text-[#171717]">→</span>
                </a>
            </div>
        </div>
    </section>

    <section class="border-t border-black/5">
        <div class="mx-auto max-w-6xl px-6 py-12 md:py-16">
            <div class="flex flex-wrap gap-12">
                {contadores.map((c) => (
                    <div>
                        <p class="font-serif text-5xl md:text-6xl">{c.total}</p>
                        <p class="mt-2 text-xs font-semibold uppercase tracking-widest text-black/60">{c.rotulo}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <section class="border-t border-black/5 sticky top-[73px] z-40 bg-[#FAFAF7]/95 backdrop-blur">
        <div class="mx-auto max-w-6xl px-6 py-6">
            <div class="flex flex-wrap gap-2" id="pubFilters">
                {categorias.map((cat) => (
                    <button
                        data-category={cat}
                        class="pub-filter-btn rounded-full border border-black/15 px-4 py-2 text-sm transition-colors hover:border-[#171717] hover:text-[#171717]"
                    >
                        {cat}
                    </button>
                ))}
            </div>
        </div>
    </section>

    <section>
        <div class="mx-auto max-w-4xl px-6 py-12 md:py-16">
            {anos.map((ano) => (
                <div class="year-group mb-16" data-year={ano}>
                    <h2 class="font-serif text-6xl md:text-7xl text-black/10 mb-6">{ano}</h2>
                    <div class="space-y-6">
                        {grupos[ano].map((pub) => (
                            <div
                                data-category={pub.data.category}
                                class="pub-item border-t border-black/10 pt-6"
                            >
                                <span class="inline-block text-xs font-semibold uppercase tracking-widest text-[#171717] mb-3">
                                    {pub.data.category}
                                </span>
                                <h3 class="font-serif text-xl md:text-2xl leading-snug mb-3">
                                    {pub.data.title}
                                </h3>
                                <p class="text-sm text-black/70 mb-1" set:html={renderAuthors(pub.data.authors)} />
                                <p class="text-sm italic text-black/60 mb-3">{pub.data.venue}</p>
                                <div class="flex flex-wrap gap-4 text-xs text-[#171717]">
                                    {pub.data.doi && (
                                        <a href={pub.data.doi} target="_blank" rel="noopener noreferrer" class="hover:underline">DOI →</a>
                                    )}
                                    {pub.data.pdfUrl && (
                                        <a href={pub.data.pdfUrl} target="_blank" rel="noopener noreferrer" class="hover:underline">PDF →</a>
                                    )}
                                    <button class="citation-btn hover:underline">Citação →</button>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            ))}
        </div>
    </section>

    <section class="border-t border-black/5 bg-black/[0.02]">
        <div class="mx-auto max-w-4xl px-6 py-16 text-center">
            <p class="mb-6 text-lg text-black/70">
                Precisa da lista completa para citação, avaliação ou parceria?
            </p>
            <div class="flex flex-wrap justify-center gap-3">
                <a href="#" class="rounded-md border border-black/15 px-5 py-3 text-sm font-medium hover:border-[#171717]">Baixar CV (PDF)</a>
                <a href="http://lattes.cnpq.br/8602899861883239" target="_blank" rel="noopener noreferrer" class="rounded-md border border-black/15 px-5 py-3 text-sm font-medium hover:border-[#171717]">Ver no Lattes</a>
            </div>
        </div>
    </section>
</Layout>

<script>
    const filters = document.querySelectorAll<HTMLButtonElement>(".pub-filter-btn");
    const items = document.querySelectorAll<HTMLDivElement>(".pub-item");
    const yearGroups = document.querySelectorAll<HTMLDivElement>(".year-group");

    let activeCategory = "Todos";

    function applyFilter() {
        items.forEach((item) => {
            const cat = item.dataset.category;
            if (activeCategory === "Todos" || cat === activeCategory) {
                item.style.display = "";
            } else {
                item.style.display = "none";
            }
        });
        // Esconder grupos de ano vazios
        yearGroups.forEach((group) => {
            const visibleItems = group.querySelectorAll<HTMLDivElement>(".pub-item");
            const hasVisible = Array.from(visibleItems).some(
                (i) => i.style.display !== "none",
            );
            group.style.display = hasVisible ? "" : "none";
        });
        filters.forEach((btn) => {
            if (btn.dataset.category === activeCategory) {
                btn.classList.add("bg-[#171717]", "text-white", "border-[#171717]");
                btn.classList.remove("border-black/15");
            } else {
                btn.classList.remove("bg-[#171717]", "text-white", "border-[#171717]");
                btn.classList.add("border-black/15");
            }
        });
    }

    filters.forEach((btn) => {
        btn.addEventListener("click", () => {
            activeCategory = btn.dataset.category || "Todos";
            applyFilter();
        });
    });

    applyFilter();
</script>
