---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
    const projetos = await getCollection("projetos");
    return projetos.map((projeto) => ({
        params: { slug: projeto.id },
        props: { projeto },
    }));
}

const { projeto } = Astro.props;
const { Content } = await render(projeto);
---

<Layout
    title={`${projeto.data.title} | Projetos`}
    description={projeto.data.description}
    ogImage={projeto.data.cover}
    ogType="article"
>
    {
        projeto.data.cover && (
            <section class="relative h-[55vh] min-h-[420px] overflow-hidden">
                <img
                    src={projeto.data.cover}
                    alt={projeto.data.title}
                    class="absolute inset-0 h-full w-full object-cover"
                    loading="eager"
                />
                <div class="absolute inset-0 bg-gradient-to-b from-black/50 via-black/40 to-[#FAFAF7]" />
                <div class="relative mx-auto max-w-4xl px-6 h-full flex flex-col justify-end pb-16">
                    <a
                        href="/projetos"
                        class="reveal mb-6 inline-block text-sm text-white/80 hover:text-white"
                    >
                        ← Todos os projetos
                    </a>
                    <div class="reveal reveal-delay-1 flex flex-wrap items-center gap-3 mb-4">
                        <span class="text-xs font-semibold uppercase tracking-widest text-white/80 bg-white/10 backdrop-blur px-3 py-1 rounded-full">
                            {projeto.data.category}
                        </span>
                        <span class="text-xs text-white/60">·</span>
                        <span class="text-xs text-white/80">{projeto.data.status}</span>
                    </div>
                    <h1 class="reveal reveal-delay-2 font-serif text-4xl leading-[1.05] md:text-6xl text-white mb-4">
                        {projeto.data.title}
                    </h1>
                    <p class="reveal reveal-delay-3 text-white/90 text-lg md:text-xl max-w-2xl">
                        {projeto.data.description}
                    </p>
                </div>
            </section>
        )
    }

    <article class="mx-auto max-w-3xl px-6 pt-12 pb-16">
        <div
            class="reveal flex flex-wrap gap-x-6 gap-y-2 text-sm text-black/60 border-b border-black/10 pb-6 mb-12"
        >
            <span
                ><span class="text-black/40">Período: </span>{projeto.data.year}</span
            >
            {
                projeto.data.location && (
                    <span>
                        <span class="text-black/40">Localização: </span>
                        {projeto.data.location}
                    </span>
                )
            }
            {
                projeto.data.externalUrl && (
                    <a
                        href={projeto.data.externalUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-[#171717] hover:underline"
                    >
                        Site oficial →
                    </a>
                )
            }
        </div>

        <div class="article-content reveal">
            <Content />
        </div>
    </article>

    <section class="border-t border-black/5 mt-16">
        <div class="mx-auto max-w-4xl px-6 py-16 text-center">
            <p class="reveal text-lg text-black/70 mb-6">
                Interessado neste projeto ou em colaborar?
            </p>
            <a
                href="/contato"
                class="reveal reveal-delay-1 inline-block rounded-md bg-[#171717] px-5 py-3 text-sm font-medium text-white transition-opacity hover:opacity-90"
            >
                Entrar em contato
            </a>
        </div>
    </section>
</Layout>
